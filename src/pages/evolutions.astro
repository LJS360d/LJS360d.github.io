---
import EvolutionTreeComponent from "../components/ui/evolution/EvolutionComponent";
import { evolutions } from "../data";
import { evolutionSearchKey } from "../data/lookups";
import ListPage from "../layouts/ListPage.astro";
---

<ListPage title="Evolutions" rowHeight="9rem">
  {
    evolutions.map((evolution) => (
      <EvolutionTreeComponent
        evolution={evolution}
        searchKey={evolutionSearchKey(evolution)}
      />
    ))
  }
</ListPage>

<script>
  import { initListSearch } from "../scripts/list-search";
  initListSearch();
</script>
