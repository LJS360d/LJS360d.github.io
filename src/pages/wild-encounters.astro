---
import WildEncountersComponent from "../components/ui/wildEncounters/WildEncountersComponent";
import { wildEncounters } from "../data";
import { wildEncountersSearchKey } from "../data/lookups";
import ListPage from "../layouts/ListPage.astro";
---

<ListPage title="Wild Encounters" rowHeight="12rem">
  {
    wildEncounters.map((encounters) => (
      <WildEncountersComponent
        encounters={encounters}
        searchKey={wildEncountersSearchKey(encounters)}
      />
    ))
  }
</ListPage>

<script>
  import { initListSearch } from "../scripts/list-search";
  initListSearch();
</script>
