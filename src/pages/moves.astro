---
import MoveComponent from "../components/ui/move/MoveComponent";
import { moves } from "../data";
import ListPage from "../layouts/ListPage.astro";
---

<ListPage title="Moves" rowHeight="5rem">
  {
    moves.map((move) => (
      <MoveComponent move={move} searchKey={move.name.toLowerCase()} />
    ))
  }
</ListPage>

<script>
  import { initListSearch } from "../scripts/list-search";
  initListSearch();
</script>
