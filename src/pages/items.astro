---
import ItemComponent from "../components/ui/item/ItemComponent";
import { items } from "../data";
import ListPage from "../layouts/ListPage.astro";
---

<ListPage title="Items" rowHeight="3rem">
  {
    items.map((item) => (
      <ItemComponent item={item} searchKey={item.name.toLowerCase()} />
    ))
  }
</ListPage>

<script>
  import { initListSearch } from "../scripts/list-search";
  initListSearch();
</script>
