---
import MdClose from "~icons/material-symbols/close";
import MdMenu from "~icons/material-symbols/menu";
import pkg from "../../package.json";
import { routes } from "../models/routes";

interface Props {
  title: string;
}

const { title } = Astro.props;
const id = "sidebar-toggle";
// Must stay in sync with the daisyui `themes` list in styles/global.css.
const themes = ["dark", "light", "aqua", "night"];
---

<div class="drawer min-h-svh">
  <input id={id} type="checkbox" class="drawer-toggle" />

  <div class="drawer-content flex flex-col">
    <header class="navbar bg-base-300 shadow-lg sticky top-0 z-50 min-w-0">
      <div class="navbar-start gap-2">
        <label for={id} class="btn btn-ghost btn-sm" aria-label="Open menu">
          <MdMenu class="text-lg" />
        </label>
        <h1 class="select-none truncate">{title}</h1>
      </div>
    </header>
    <main class="flex-1">
      <slot />
    </main>
  </div>

  <div class="drawer-side z-50">
    <label for={id} aria-label="close sidebar" class="drawer-overlay"></label>
    <div class="bg-base-300 flex flex-col h-full justify-between w-60">
      <div>
        <header class="flex w-full py-2 border-b border-base-content/10">
          <label for={id} class="btn pr-1 btn-ghost btn-sm">
            <MdClose class="text-xl" />
          </label>
        </header>
        <ul class="menu p-0 gap-1 text-base-content w-full">
          {
            routes.map((route) => (
              <li>
                <a
                  href={route.route}
                  class="flex items-center gap-2 py-2 px-3 capitalize hover:bg-base-content/10"
                >
                  <route.icon />
                  <span>{route.label}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      <footer
        class="flex flex-col items-center gap-2 p-4 border-t border-base-content/10"
      >
        <div class="w-full max-w-35">
          <label class="label py-0">
            <span class="label-text text-xs">Theme</span>
          </label>
          <select
            id="theme-select"
            class="select select-sm select-bordered w-full capitalize"
            name="theme"
            onchange="document.documentElement.setAttribute('data-theme', this.value); localStorage.setItem('theme', this.value);"
          >
            {themes.map((t) => <option value={t}>{t}</option>)}
          </select>
        </div>
        <span class="text-xs opacity-80">v{pkg.version}</span>
      </footer>
    </div>
  </div>
</div>

<!-- The theme itself is applied in <head>; this only syncs the <select>. -->
<script is:inline>
  document.getElementById("theme-select").value =
    document.documentElement.getAttribute("data-theme");
</script>
